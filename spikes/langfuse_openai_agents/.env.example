# Copy values into the process environment or a local .env (never commit secrets).
# Langfuse project keys: https://cloud.langfuse.com (or your self-hosted URL)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenRouter (this spike). The script also reads the parent project .env.
OPENROUTER_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
